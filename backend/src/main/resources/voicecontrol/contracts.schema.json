        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "executionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "proposalId",
        "status",
        "planVersion",
        "planHash",
        "plan",
        "requiresConfirmation",
        "createdAt",
        "expiresAt",
        "executionId"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "CONFIRMED"
              }
            }
          },
          "then": {
            "properties": {
              "executionId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          },
          "else": {
            "properties": {
              "executionId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Execution": {
