{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Voice P0 design contracts (not implemented APIs)",
  "description": "Validate a named definition using fixtures; root intentionally rejects unspecified message types. Semantic equality and state transitions are tested separately.",
  "not": {},
  "definitions": {
    "ProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "runtimeGeneration": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expectedContextVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intent": {
          "type": "string",
          "enum": [
            "MISSION_START",
            "MISSION_PAUSE",
            "MISSION_RESUME",
            "MISSION_STOP",
            "SINGLE_DEVICE_CONTROL"
          ]
        }
      },
      "required": [
        "runtimeRef",
        "runtimeGeneration",
        "expectedContextVersion",
        "intent"
      ]
    },
    "ConfirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedPlanVersion": {
          "const": 1
        },
        "expectedPlanHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "expectedPlanVersion",
        "expectedPlanHash"
      ]
    },
    "CancelRequest": {
      "$ref": "#/definitions/ConfirmRequest"
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "runtimeGeneration": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "contextVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "action": {
          "type": "string",
          "enum": [
            "START",
            "PAUSE",
            "RESUME",
            "STOP",
            "DEVICE_COMMAND"
          ]
        },
        "targetDeviceCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "deviceCommandType": {
          "type": "string",
          "enum": ["UAV_HOVER", "UAV_RESUME", "UAV_RETURN", "UAV_LAND", "USV_HOLD", "USV_RESUME", "USV_RETURN", "USV_STOP"]
        },
        "explicitDeviceCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "uniqueItems": true,
          "maxItems": 200,
          "minItems": 1
        },
        "policyVersion": {
          "const": "voice-p0.v1"
        }
      },
      "required": [
        "runtimeRef",
        "runtimeGeneration",
        "contextVersion",
        "stateVersion",
        "action",
        "explicitDeviceCodes",
        "policyVersion"
      ],
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "DEVICE_COMMAND" } } },
          "then": {
            "required": ["targetDeviceCode", "deviceCommandType"],
            "properties": { "explicitDeviceCodes": { "minItems": 1, "maxItems": 1 } }
          }
        }
      ]
    },
    "RuntimeContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "runtimeGeneration": {
          "type": "string",
