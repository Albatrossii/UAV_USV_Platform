      "required": [
        "executionId",
        "proposalId",
        "commandId",
        "runtimeRef",
        "runtimeGeneration",
        "action",
        "state",
        "outcome",
        "errorCode",
        "timedOutAt",
        "presentationStatus",
        "createdAt",
        "updatedAt"
