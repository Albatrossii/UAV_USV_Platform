        "runtimeGeneration",
        "contextVersion",
        "stateVersion",
        "runtimeScope",
        "runtimeKind",
        "executionBackend",
        "algorithmRunId",
        "missionId",
        "missionRunId",
        "state",
        "protocolVersion",
        "capabilities",
        "lastHeartbeatReceivedAt",
        "latestFrameSequence",
        "sceneReady"
      ]
    },
    "Proposal": {
