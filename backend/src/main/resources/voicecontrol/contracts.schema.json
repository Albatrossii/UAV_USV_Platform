          "then": {
            "properties": {
              "outcome": {
                "const": "UNKNOWN"
              },
              "timedOutAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
              },
              "errorCode": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "QUEUED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "UNKNOWN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "DISPATCHED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "UNKNOWN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "ACCEPTED"
