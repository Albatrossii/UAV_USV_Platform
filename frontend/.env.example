# Backend used by the Vite development proxy.
VITE_BACKEND_TARGET=http://127.0.0.1:8081

# Explicit frontend-only P0 demo mode. Never enable this in an integration or
# production build: it simulates proposal/execution state and does not control
# the Python algorithm or either Unity project.
VITE_VOICE_P0_MOCK=false

# Enable only after Unity implements the frozen unity.presentation.v1 draft.
# Old scenarioReady/poseFrameApplied callbacks are intentionally not promoted
# into fresh presentation evidence.
VITE_VOICE_UNITY_PRESENTATION_V1=false

# Provider-neutral P1 voice/text input. Local ASR + local-LLM voice candidates
# can auto-submit only to the protected Python simulation runtime. Typed text
# remains a review-and-submit flow; non-local and ambiguous results never run.
VITE_VOICE_P1_PREPARATION=false

# Local recognition/intent simulation for frontend development. Keep false in
# integration and production; no real ASR or LLM is called in this mode.
VITE_VOICE_P1_MOCK=false

# Enable only after the backend implements the frozen provider-neutral P1
# endpoints. Never enable together with VITE_VOICE_P1_MOCK.
VITE_VOICE_P1_BACKEND=false

# D1 /asr: real Java transcription only; overrides legacy P1 input, no mock fallback.
# Java must enable its local-asr provider separately.
VITE_VOICE_ASR_ONLY=false
